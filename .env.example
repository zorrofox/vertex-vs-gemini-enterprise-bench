# GCP 项目配置（必填）
GCP_PROJECT_ID=your-project-id
GCP_PROJECT_NUMBER=your-project-number

# 区域配置
VERTEX_LOCATION=us-central1
DISCOVERY_LOCATION=global

# 底层模型
GEMINI_MODEL=gemini-2.5-flash

# Gemini Enterprise (Agentspace) App，需开启 googleSearchGroundingEnabled
# 用 python scripts/list_engines.py [project-id] 查询可用 engine
AGENT_SEARCH_ENGINE=your-agentspace-app-id
AGENT_SEARCH_ASSISTANT=default_assistant
# streamAssist generationSpec.modelId（留空用 App 默认）
AGENT_SEARCH_MODEL_VERSION=

# 认证来源: gcloud (CLI active account) | adc
GCP_AUTH_SOURCE=gcloud

# 代理服务
PROXY_HOST=0.0.0.0
PROXY_PORT=8000

# CORS 允许的前端来源（逗号分隔）
CORS_ORIGINS=http://localhost:8501
